<!-- Undo, redo, back to the start and rotate are not in here: they are
     the buttons below the board, always one tap away. The toolbar shows
     new game and the play mode, the overflow the rest in
     groups (separated by dividers, see DroidZebra#onCreateOptionsMenu). -->
<menu xmlns:app="http://schemas.android.com/apk/res-auto"
      xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/menu_new_game"
        android:icon="@drawable/ic_play_arrow_white_24dp"
        android:title="@string/menu_item_new_game"
        app:showAsAction="ifRoom" />
    <!-- Cycles analysis / vs computer / vs human. Icon and title show the
         current mode and are set in DroidZebra#onPrepareOptionsMenu. -->
    <item
        android:id="@+id/menu_play_mode"
        android:icon="@drawable/ic_assessment_white_24dp"
        android:title="@string/onboarding_mode_analyze"
        app:showAsAction="ifRoom" />

    <!-- the current game -->
    <group android:id="@+id/menu_group_game">
        <!-- The same modes as the toolbar button, to pick directly and with
             a readable name. Icon and checked mode are set in
             DroidZebra#onPrepareOptionsMenu. -->
        <item
            android:id="@+id/menu_play_mode_choice"
            android:icon="@drawable/ic_assessment_white_24dp"
            android:title="@string/menu_item_play_mode">
            <menu>
                <group android:checkableBehavior="single">
                    <item
                        android:id="@+id/menu_mode_analysis"
                        android:title="@string/onboarding_mode_analyze" />
                    <item
                        android:id="@+id/menu_mode_vs_computer"
                        android:title="@string/onboarding_mode_vs_computer" />
                    <item
                        android:id="@+id/menu_mode_vs_human"
                        android:title="@string/onboarding_mode_vs_human" />
                </group>
            </menu>
        </item>
        <item
            android:id="@+id/menu_switch_sides"
            android:icon="@drawable/ic_swap_horiz_white_24dp"
            android:title="@string/menu_item_switch_sides" />
        <item
            android:id="@+id/menu_hint"
            android:icon="@drawable/ic_wb_incandescent_white_24dp"
            android:title="@string/menu_item_hint" />
        <item
            android:id="@+id/menu_analyze_game"
            android:icon="@drawable/ic_assessment_white_24dp"
            android:title="@string/gameover_choices_analyze" />
    </group>

    <!-- games in and out -->
    <group android:id="@+id/menu_group_transcript">
        <item
            android:id="@+id/menu_enter_moves"
            android:icon="@drawable/ic_edit_white_24dp"
            android:title="@string/menu_enter_moves" />
        <item
            android:id="@+id/menu_mail"
            android:icon="@drawable/ic_email_white_24dp"
            android:title="@string/menu_item_mail" />
    </group>

    <group android:id="@+id/menu_group_app">
        <item
            android:id="@+id/menu_guess_move"
            android:icon="@drawable/ic_question_answer_white_24dp"
            android:title="@string/menu_item_guess_move" />
        <item
            android:id="@+id/menu_settings"
            android:icon="@drawable/ic_settings_white_24dp"
            android:title="@string/menu_item_settings" />
        <item
            android:id="@+id/menu_quit"
            android:icon="@drawable/ic_exit_to_app_exit_24dp"
            android:title="@string/menu_item_quit" />
    </group>
</menu>
